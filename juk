AddButton(ToolsTabPage, "8. อุปกรณ์ลบ/ย้ายบล็อก (BTools)", function()
    local bp = LocalPlayer:WaitForChild("Backpack")
    for _, binType in pairs({Enum.BinType.Hammer, Enum.BinType.Clone, Enum.BinType.Grab}) do
        local tool = Instance.new("HopperBin")
        tool.BinType = binType
        tool.Parent = bp
    end
end)

AddButton(ToolsTabPage, "9. ดึงของในแมพมาหาตัว (Item Grabber)", function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        for _, item in pairs(workspace:GetDescendants()) do
            if item:IsA("Tool") and not item:IsDescendantOf(char) and item:FindFirstChild("Handle") then
                item.Handle.CFrame = char.HumanoidRootPart.CFrame
            end
        end
    end
end)

AddSlider(ToolsTabPage, "10. ความเร็วรถ/เรือ (Vehicle Speed)", 50, 500, 50, function(val)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local seat = LocalPlayer.Character.Humanoid.SeatPart
        if seat and seat:IsA("VehicleSeat") then
            seat.MaxSpeed = val
            seat.Torque = val * 2
        end
    end
end)

