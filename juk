        if obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Decal") or obj:IsA("Texture") then
            obj:Destroy()
        end
    end
end)

-- ฟังก์ชันที่ 13: เตะผู้เล่น (อยู่ล่างสุดของช่องช่วย)
AddInputWithButton(AssistTabPage, "13. ใส่ชื่อผู้เล่นที่จะเตะ...", "Kick", function(targetText)
    if targetText == "" then return end
    
    local targetTextLower = string.lower(targetText)
    local targetPlayer = nil
    
    -- ค้นหาผู้เล่นที่ชื่อตรง หรือพิมพ์บางส่วนของชื่อ
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if string.find(string.lower(player.Name), targetTextLower) or string.find(string.lower(player.DisplayName), targetTextLower) then
                targetPlayer = player
                break
            end
        end
    end
    
    if targetPlayer then
        -- ลองใช้ระบบ Local Kick 
        pcall(function()
            targetPlayer:Kick("คุณถูกเตะออกจากเกมโดย PEEM HUD")
        end)
    end
end)

